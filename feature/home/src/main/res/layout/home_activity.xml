<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the window's content FrameLayout: one view level less to lay out and draw. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr"
        android:orientation="vertical">

        <com.luncher.launcher.home.TopBarView
            android:id="@+id/home_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/home_padding_horizontal"
            android:paddingTop="@dimen/home_padding_vertical"
            android:paddingRight="@dimen/home_padding_horizontal">

            <com.luncher.launcher.home.ClockView
                android:id="@+id/home_clock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.luncher.launcher.home.OutlinedTextView
                    android:id="@+id/home_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/home_time_text" />

                <com.luncher.launcher.home.OutlinedTextView
                    android:id="@+id/home_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/home_date_text" />
            </com.luncher.launcher.home.ClockView>

            <com.luncher.launcher.home.OutlinedTextView
                android:id="@+id/home_move_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:minHeight="@dimen/home_settings_size"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="@string/home_move_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/home_time_text"
                android:visibility="gone" />

            <com.luncher.launcher.home.OutlinedTextView
                android:id="@+id/home_move_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/home_move_hint"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/home_move_hint_text"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/home_settings"
                android:layout_width="@dimen/home_settings_size"
                android:layout_height="@dimen/home_settings_size"
                android:contentDescription="@string/home_settings"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="@dimen/home_settings_padding"
                android:src="@drawable/home_settings" />
        </com.luncher.launcher.home.TopBarView>

        <!-- PS5-inspired media navigation: visual section labels, not fake buttons. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/home_padding_horizontal"
            android:paddingRight="@dimen/home_padding_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="28dp"
                android:text="MEDIA"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="28dp"
                android:text="APPS"
                android:textColor="#8994A8"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIBRARY"
                android:textColor="#8994A8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Cinematic feature panel. Kept informational until real service integrations exist. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:layout_marginLeft="@dimen/home_padding_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginRight="@dimen/home_padding_horizontal"
            android:layout_marginBottom="8dp"
            android:background="#18243A"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="22dp"
            android:paddingTop="12dp"
            android:paddingRight="22dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ODYSSEY  •  ENTERTAINMENT"
                android:textColor="#70A7FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Your entertainment starts here."
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Choose a streaming app below."
                android:textColor="#B7C2D4"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Installed TV apps remain real launchable tiles, with the existing D-pad and menu logic. -->
        <com.luncher.launcher.home.AppTilesView
            android:id="@+id/home_apps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingLeft="@dimen/home_padding_horizontal"
            android:paddingTop="@dimen/home_tiles_padding_top"
            android:paddingRight="@dimen/home_padding_horizontal"
            android:paddingBottom="@dimen/home_padding_vertical" />
    </LinearLayout>

    <com.luncher.launcher.home.OutlinedTextView
        android:id="@+id/home_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/home_no_apps"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/home_empty_text"
        android:visibility="gone" />

</merge>
